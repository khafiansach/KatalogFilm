<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER PROFIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKUN SAYA"
            android:textColor="#00D9FF"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Profil Pengguna"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- KARTU PENGGUNA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#1E2B38">

            <TextView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/profile_circle"
                android:gravity="center"
                android:text="K"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Khafiansach"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Movie Space Member"
                android:textColor="#AAB7C4"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:background="#302744"
                android:text="MOVIE ENTHUSIAST"
                android:textColor="#BB86FC"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- STATISTIK FILM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Aktivitas Film"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- TOTAL FILM -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="#1E2B38"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="Ikon total film"
                    android:tint="#00D9FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="3 Film"
                    android:textColor="#00D9FF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Dalam katalog"
                    android:textColor="#AAB7C4"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- FAVORIT: SEKARANG BISA DIKLIK -->
            <LinearLayout
                android:id="@+id/kartuFavorit"
                android:layout_width="0dp"
                android:layout_height="125dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="#1E2B38"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/btn_star_big_on"
                    android:contentDescription="Ikon favorit"
                    android:tint="#BB86FC" />

                <TextView
                    android:id="@+id/txtJumlahFavorit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Favorit"
                    android:textColor="#BB86FC"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Film pilihanmu"
                    android:textColor="#AAB7C4"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- TENTANG APLIKASI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#1E2B38">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tentang Movie Space"
                android:textColor="#00D9FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jelajahi berbagai film, baca sinopsis, lihat detail, dan temukan cerita favoritmu dalam satu aplikasi."
                android:textColor="#D4DCE4"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="#BB86FC" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
